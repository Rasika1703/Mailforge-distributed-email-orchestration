# Server
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public"

# Redis (BullMQ + rate limiting + sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Sessions
SESSION_SECRET=change-me-to-a-long-random-string

#SMTP passwords and Slack tokens in the database. 
TOKEN_ENCRYPTION_KEY=

# Google OAuth 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Ethereal Email 
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# Worker / scheduling behavior
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100

# Bull Board admin auth 
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
